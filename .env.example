# Roland environment — loaded automatically by the CLI and MCP server.
# Copy to ~/.roland/.env (global) or your project root as .env
# Get your Cursor API key: https://cursor.com/settings → API Keys

CURSOR_API_KEY=

# Optional — GitHub PR automation
# GITHUB_TOKEN=

# Optional — telemetry (opt-in error reporting)
# RCO_TELEMETRY_CONSENT=0
